[Unit]
Description=Switchboard — index of HTTP services on this machine
Documentation=https://github.com/you/switchboard
After=network.target

[Service]
Type=exec
# Switchboard is stateless, so systemd can allocate a transient unprivileged
# identity each time the service starts.
DynamicUser=yes

ExecStart=/usr/local/bin/switchboard --port 8090
Restart=on-failure
RestartSec=2s

# --- the privileges Switchboard actually wants ----------------------------
#
# Reading /proc/net/tcp needs nothing at all: every listening socket on the box
# is already world-readable there, so ports, bind addresses and tiers work for
# any user.
#
# Attributing a socket to a process is the part that needs help, and it takes
# *two* capabilities because the walk crosses two different kernel checks:
#
#   1. Listing /proc/<pid>/fd. The directory is dr-x------ owned by the target's
#      uid, so this is an ordinary DAC check in generic_permission().
#      CAP_DAC_READ_SEARCH bypasses it. CAP_SYS_PTRACE does not — it is not a
#      DAC capability, and without CAP_DAC_READ_SEARCH the walk gets EACCES here
#      and never reaches step 2 at all.
#   2. Resolving each socket:[N] symlink inside it. That goes through
#      proc_fd_access_allowed() -> ptrace_may_access(), which CAP_SYS_PTRACE
#      bypasses and CAP_DAC_READ_SEARCH does not.
#
# Granting only one of the two yields no process names for other users at all,
# which is indistinguishable from granting neither.
#
# The cost is real: CAP_SYS_PTRACE also permits reading the memory of any
# process on the box, and CAP_DAC_READ_SEARCH permits reading any file. If you
# would rather not, delete both lines below — Switchboard degrades cleanly,
# showing other users' services with the process name "unknown" while
# everything else keeps working.
AmbientCapabilities=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH

# Ports below 1024 would additionally need CAP_NET_BIND_SERVICE in both lines
# above. The default port, 8090, does not.

# --- hardening ------------------------------------------------------------
NoNewPrivileges=yes
# /proc must stay fully visible: it is the entire data source. ProtectProc= and
# ProcSubset= are named explicitly so a future distro default cannot quietly
# hide the process tree and turn every service into "unknown".
ProtectProc=default
ProcSubset=all
# PrivateUsers= must stay off. Inside a user namespace both capabilities above
# would apply only within it, which is exactly the set of processes we did not
# need them for: ptrace_may_access() checks CAP_SYS_PTRACE against the target's
# user namespace, and the DAC check honours CAP_DAC_READ_SEARCH only over files
# whose owning uid is mapped into ours.
PrivateUsers=no

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
