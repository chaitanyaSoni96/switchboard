[Unit]
Description=Switchboard — index of HTTP services on this machine
Documentation=https://github.com/you/switchboard
After=network.target

[Service]
Type=exec
# Switchboard never needs to be root. Set this to whatever unprivileged account
# should own the process; a dedicated `switchboard` system user is ideal.
User=switchboard
Group=switchboard
DynamicUser=no

ExecStart=/usr/local/bin/switchboard --port 8090
Restart=on-failure
RestartSec=2s

# --- the one privilege Switchboard actually wants -------------------------
#
# Reading /proc/net/tcp needs nothing at all: every listening socket on the box
# is already world-readable there, so ports, bind addresses and tiers work for
# any user.
#
# Attributing a socket to a process is the part that needs help. /proc/<pid>/fd
# is gated by ptrace_may_access(), so an unprivileged process can only read the
# fd table of processes owned by the same user. CAP_SYS_PTRACE bypasses that
# check and is the *only* capability that does; CAP_DAC_READ_SEARCH is not
# enough, because the block is the ptrace check rather than file permissions.
#
# The cost of granting it is real: CAP_SYS_PTRACE also permits reading the
# memory of any process on the box. If you would rather not, delete both lines
# below — Switchboard degrades cleanly, showing other users' services with the
# process name "unknown" while everything else keeps working.
AmbientCapabilities=CAP_SYS_PTRACE
CapabilityBoundingSet=CAP_SYS_PTRACE

# Ports below 1024 would additionally need CAP_NET_BIND_SERVICE in both lines
# above. The default port, 8090, does not.

# --- hardening ------------------------------------------------------------
NoNewPrivileges=yes
# /proc must stay fully visible: it is the entire data source. ProtectProc= and
# ProcSubset= are named explicitly so a future distro default cannot quietly
# hide the process tree and turn every service into "unknown".
ProtectProc=default
ProcSubset=all
# PrivateUsers= must stay off — a user namespace makes CAP_SYS_PTRACE apply
# only inside it, which is exactly the set of processes we did not need it for.
PrivateUsers=no

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
